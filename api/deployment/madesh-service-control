#!/bin/sh
# /usr/local/sbin/madesh-service-control

if [ "$#" -ne 2 ]; then
    echo "Usage: $0 <service_name> <action>"
    exit 1
fi

SERVICE_NAME="$1"
ACTION="$2"

# Validate action
if [ "$ACTION" != "start" ] && [ "$ACTION" != "stop" ] && [ "$ACTION" != "restart" ]; then
    echo "Invalid action"
    exit 1
fi

# Validate service
if [ "$SERVICE_NAME" != "madesh-api" ] && [ "$SERVICE_NAME" != "cloudflared" ] && [ "$SERVICE_NAME" != "docker" ]; then
    echo "Invalid service"
    exit 1
fi

exec systemctl "$ACTION" "$SERVICE_NAME"
